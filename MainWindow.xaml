<Window x:Class="MyPersonalDjGui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MyDJ — FUTABA PALACE"
        Height="620" Width="960"
        Background="{StaticResource DeepBrush}"
        FontFamily="Segoe UI"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResizeWithGrip">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="42"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#0D0D0D"
                BorderBrush="#E8001A"
                BorderThickness="0,0,0,2"
                Padding="20,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="M 8,0 L 16,8 8,16 0,8 Z"
                          Fill="#E8001A"
                          Width="16" Height="16"
                          Margin="0,0,10,0"
                          VerticalAlignment="Center"/>
                    <TextBlock Text="MY DJ"
                               Foreground="White"
                               FontSize="18"
                               FontWeight="Black"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="  // FUTABA PALACE"
                               Foreground="#F97316"
                               FontSize="11"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="4,0,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot"
                             Width="8" Height="8"
                             Fill="#E8001A"
                             Margin="0,0,6,0"/>
                    <TextBlock x:Name="HeaderStatus"
                               Text="Ready"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="16,12,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource CardBrush}"
                    BorderBrush="#E8001A"
                    BorderThickness="1"
                    CornerRadius="0"
                    Padding="24">
                <Border.Clip>
                    <PathGeometry>
                        <PathFigure StartPoint="18,0" IsClosed="True">
                            <LineSegment Point="10000,0"/>
                            <LineSegment Point="10000,10000"/>
                            <LineSegment Point="0,10000"/>
                            <LineSegment Point="0,18"/>
                        </PathFigure>
                    </PathGeometry>
                </Border.Clip>

                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Background="#E8001A"
                                Padding="8,3"
                                CornerRadius="0">
                            <TextBlock Text="NOW PLAYING"
                                       Foreground="White"
                                       FontSize="10"
                                       FontWeight="Black"/>
                        </Border>
                    </StackPanel>

                    <Canvas Width="110" Height="110"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,16">
                        <Ellipse Canvas.Left="0" Canvas.Top="0"
                                 Width="110" Height="110">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="#1C1C1C" Offset="0.0"/>
                                    <GradientStop Color="#2A0000"  Offset="0.6"/>
                                    <GradientStop Color="#0D0D0D"  Offset="1.0"/>
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <Ellipse Canvas.Left="10" Canvas.Top="10"
                                 Width="90" Height="90"
                                 Stroke="#33E8001A" StrokeThickness="1" Fill="Transparent"/>
                        <Ellipse Canvas.Left="20" Canvas.Top="20"
                                 Width="70" Height="70"
                                 Stroke="#44E8001A" StrokeThickness="1" Fill="Transparent"/>
                        <Ellipse Canvas.Left="30" Canvas.Top="30"
                                 Width="50" Height="50"
                                 Stroke="#55E8001A" StrokeThickness="1" Fill="Transparent"/>
                        <Ellipse Canvas.Left="48" Canvas.Top="48"
                                 Width="14" Height="14"
                                 Fill="#E8001A"/>
                        <Ellipse Canvas.Left="22" Canvas.Top="38"
                                 Width="24" Height="18"
                                 Fill="#CC000000"
                                 Stroke="#E8001A" StrokeThickness="2"/>
                        <Ellipse Canvas.Left="64" Canvas.Top="38"
                                 Width="24" Height="18"
                                 Fill="#CC000000"
                                 Stroke="#E8001A" StrokeThickness="2"/>
                        <Line X1="46" Y1="47" X2="64" Y2="47"
                               Stroke="#E8001A" StrokeThickness="2"/>
                        <Line X1="22" Y1="47" X2="5" Y2="43"
                               Stroke="#E8001A" StrokeThickness="1.5"/>
                        <Line X1="88" Y1="47" X2="105" Y2="43"
                               Stroke="#E8001A" StrokeThickness="1.5"/>
                        <Ellipse Canvas.Left="25" Canvas.Top="40"
                                 Width="8" Height="5"
                                 Fill="#44FF1A30"/>
                        <Ellipse Canvas.Left="67" Canvas.Top="40"
                                 Width="8" Height="5"
                                 Fill="#44FF1A30"/>
                    </Canvas>

                    <TextBlock x:Name="SongTitleText"
                               Text="No Song Selected"
                               Foreground="White"
                               FontSize="22"
                               FontWeight="Black"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,0,0,4"/>

                    <TextBlock x:Name="ArtistText"
                               Text="— / —"
                               Foreground="#F97316"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Margin="0,0,0,20"/>

                    <Slider x:Name="SeekBar"
                            Style="{StaticResource SeekSliderStyle}"
                            Minimum="0" Maximum="100" Value="0"
                            IsMoveToPointEnabled="True"
                            Margin="0,0,0,6"
                            ValueChanged="SeekBar_ValueChanged"
                            PreviewMouseLeftButtonDown="SeekBar_PreviewMouseLeftButtonDown"
                            PreviewMouseLeftButtonUp="SeekBar_PreviewMouseLeftButtonUp"/>

                    <Grid Margin="0,0,0,20">
                        <TextBlock x:Name="TimeElapsed"
                                   Text="0:00"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11"
                                   HorizontalAlignment="Left"/>
                        <TextBlock x:Name="TimeTotal"
                                   Text="0:00"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11"
                                   HorizontalAlignment="Right"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,20">
                        <Button x:Name="ShuffleButton"
                                Content="⇄"
                                Style="{StaticResource ControlButtonStyle}"
                                Click="ShuffleButton_Click"
                                ToolTip="Shuffle"
                                Margin="0,0,6,0"/>
                        <Button x:Name="PrevButton"
                                Content="⏮"
                                Style="{StaticResource ControlButtonStyle}"
                                Click="PrevButton_Click"
                                ToolTip="Previous"
                                Margin="0,0,6,0"/>
                        <Button x:Name="PlayButton"
                                Content="▶"
                                Style="{StaticResource PlayButtonStyle}"
                                Click="PlayButton_Click"
                                Margin="0,0,6,0"/>
                        <Button x:Name="NextButton"
                                Content="⏭"
                                Style="{StaticResource ControlButtonStyle}"
                                Click="NextButton_Click"
                                ToolTip="Next"
                                Margin="0,0,6,0"/>
                        <Button x:Name="StopButton"
                                Content="⏹"
                                Style="{StaticResource ControlButtonStyle}"
                                Click="StopButton_Click"
                                ToolTip="Stop"/>
                    </StackPanel>

                </StackPanel>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{StaticResource CardBrush}"
                        BorderBrush="#E8001A"
                        BorderThickness="1"
                        CornerRadius="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Background="#E8001A"
                                Padding="14,8">
                            <Grid>
                                <TextBlock Text="PLAYLIST"
                                           Foreground="White"
                                           FontSize="10"
                                           FontWeight="Black"
                                           VerticalAlignment="Center"/>
                                <Border HorizontalAlignment="Right"
                                        Background="#33000000"
                                        CornerRadius="0"
                                        Padding="6,2">
                                    <TextBlock x:Name="SongCountLabel"
                                               Text="0 songs"
                                               Foreground="White"
                                               FontSize="10"/>
                                </Border>
                            </Grid>
                        </Border>

                        <ListBox x:Name="SongListBox"
                                 Grid.Row="1"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="White"
                                 FontSize="13"
                                 ItemContainerStyle="{StaticResource SongListItemStyle}"
                                 MouseDoubleClick="SongListBox_MouseDoubleClick"
                                 SelectionChanged="SongListBox_SelectionChanged"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2"
                Background="#0D0D0D"
                BorderBrush="#E8001A"
                BorderThickness="0,2,0,0"
                Padding="20,0">
            <Grid VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="M 5,0 L 10,5 5,10 0,5 Z"
                          Fill="#E8001A"
                          Width="10" Height="10"
                          Margin="0,0,6,0"
                          VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusText"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="11"
                               VerticalAlignment="Center">
                        <Run Text="MyDJ — "/>
                        <Run x:Name="StatusRun"
                             Text="Ready"
                             Foreground="#E8001A"/>
                    </TextBlock>
                </StackPanel>
                <Button x:Name="LoadFolderButton"
                        HorizontalAlignment="Right"
                        Content="📁 Load Folder"
                        Style="{StaticResource ControlButtonStyle}"
                        Click="LoadFolderButton_Click"
                        Foreground="White"
                        BorderBrush="#E8001A"
                        BorderThickness="1"
                        Padding="12,6"/>
            </Grid>
        </Border>

    </Grid>
</Window>