<Window x:Class="MyPersonalDjGui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MyDJ" Height="620" Width="960"
        Background="{StaticResource DeepBrush}"
        FontFamily="Segoe UI"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResizeWithGrip">

    <!-- ROOT: 3 rows — header / main / footer -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>   <!-- Header bar -->
            <RowDefinition Height="*"/>    <!-- Main content -->
            <RowDefinition Height="42"/>   <!-- Footer bar -->
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════ HEADER ═══ -->
        <Border Grid.Row="0"
                BorderBrush="#309B5DE5"
                BorderThickness="0,0,0,1"
                Padding="20,0">
            <Grid>
                <TextBlock Text="My DJ"
                           Foreground="{StaticResource PurpleBrightBrush}"
                           FontSize="20" FontWeight="Bold"
                           VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot"
                             Width="8" Height="8"
                             Fill="{StaticResource AccentBrush}"
                             Margin="0,0,6,0"/>
                    <TextBlock x:Name="HeaderStatus"
                               Text="Ready"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="12"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════ MAIN ════ -->
        <Grid Grid.Row="1" Margin="16,12,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>      <!-- Now Playing panel -->
                <ColumnDefinition Width="16"/>     <!-- gap -->
                <ColumnDefinition Width="280"/>    <!-- Sidebar -->
            </Grid.ColumnDefinitions>

            <!-- ── NOW PLAYING PANEL ── -->
            <Border Grid.Column="0"
                    Background="{StaticResource CardBrush}"
                    BorderBrush="#309B5DE5"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="24">
                <StackPanel>

                    <!-- Label -->
                    <TextBlock Text="NOW PLAYING"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="10" FontWeight="SemiBold"
                               LetterSpacing="3"
                               Margin="0,0,0,16"/>

                    <!-- Album art placeholder (vinyl disc look) -->
                    <Ellipse Width="100" Height="100"
                             HorizontalAlignment="Center"
                             Margin="0,0,0,16">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#1A0030" Offset="0.0"/>
                                <GradientStop Color="#2D0050" Offset="0.5"/>
                                <GradientStop Color="#1A0030" Offset="1.0"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>

                    <!-- Song title -->
                    <TextBlock x:Name="SongTitleText"
                               Text="No Song Selected"
                               Foreground="White"
                               FontSize="22" FontWeight="Bold"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,0,0,4"/>

                    <!-- Artist -->
                    <TextBlock x:Name="ArtistText"
                               Text="— / —"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="12"
                               Margin="0,0,0,20"/>

                    <!-- Seek slider -->
                    <Slider x:Name="SeekBar"
                            Style="{StaticResource SeekSliderStyle}"
                            Minimum="0" Maximum="100" Value="0"
                            Margin="0,0,0,6"
                            ValueChanged="SeekBar_ValueChanged"/>

                    <!-- Time row -->
                    <Grid Margin="0,0,0,20">
                        <TextBlock x:Name="TimeElapsed"
                                   Text="0:00"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="TimeTotal"
                                   Text="0:00"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11" HorizontalAlignment="Right"/>
                    </Grid>

                    <!-- Transport controls -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,20">

                        <Button x:Name="ShuffleButton"
                                Content="⇄"
                                Style="{StaticResource ControlButtonStyle}"
                                Click="ShuffleButton_Click"
                                ToolTip="Shuffle"
                                Margin="0,0,6,0"/>

                        <Button x:Name="PrevButton"
                                Content="⏮"
                                Style="{StaticResource ControlButtonStyle}"
                                Click="PrevButton_Click"
                                ToolTip="Previous"
                                Margin="0,0,6,0"/>

                        <!-- Big play/pause button -->
                        <Button x:Name="PlayButton"
                                Content="▶"
                                Style="{StaticResource PlayButtonStyle}"
                                Click="PlayButton_Click"
                                Margin="0,0,6,0"/>

                        <Button x:Name="NextButton"
                                Content="⏭"
                                Style="{StaticResource ControlButtonStyle}"
                                Click="NextButton_Click"
                                ToolTip="Next"
                                Margin="0,0,6,0"/>

                        <Button x:Name="StopButton"
                                Content="⏹"
                                Style="{StaticResource ControlButtonStyle}"
                                Click="StopButton_Click"
                                ToolTip="Stop"/>
                    </StackPanel>

                    <!-- Volume row -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="36"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="🔈"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="14"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>

                        <Slider x:Name="VolumeSlider"
                                Grid.Column="1"
                                Style="{StaticResource SeekSliderStyle}"
                                Minimum="0" Maximum="100" Value="70"
                                VerticalAlignment="Center"
                                ValueChanged="VolumeSlider_ValueChanged"/>

                        <TextBlock x:Name="VolumeLabel"
                                   Grid.Column="2"
                                   Text="70%"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right"/>
                    </Grid>

                </StackPanel>
            </Border>

            <!-- ── SIDEBAR ── -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>    <!-- Playlist -->
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/> <!-- EQ card -->
                </Grid.RowDefinitions>

                <!-- Playlist card -->
                <Border Grid.Row="0"
                        Background="{StaticResource CardBrush}"
                        BorderBrush="#309B5DE5"
                        BorderThickness="1"
                        CornerRadius="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Playlist header -->
                        <Border Grid.Row="0"
                                BorderBrush="#309B5DE5"
                                BorderThickness="0,0,0,1"
                                Padding="14,10">
                            <Grid>
                                <TextBlock Text="PLAYLIST"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontSize="10" FontWeight="SemiBold"
                                           LetterSpacing="2"
                                           VerticalAlignment="Center"/>
                                <Border HorizontalAlignment="Right"
                                        Background="#1F9B5DE5"
                                        CornerRadius="10"
                                        Padding="6,2">
                                    <TextBlock x:Name="SongCountLabel"
                                               Text="0 songs"
                                               Foreground="{StaticResource MutedBrush}"
                                               FontSize="10"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- The actual song list -->
                        <ListBox x:Name="SongListBox"
                                 Grid.Row="1"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="White"
                                 FontSize="13"
                                 ItemContainerStyle="{StaticResource SongListItemStyle}"
                                 MouseDoubleClick="SongListBox_MouseDoubleClick"
                                 SelectionChanged="SongListBox_SelectionChanged"/>
                    </Grid>
                </Border>

                <!-- EQ card -->
                <Border Grid.Row="2"
                        Background="{StaticResource CardBrush}"
                        BorderBrush="#309B5DE5"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="EQUALIZER"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontSize="10" FontWeight="SemiBold"
                                   LetterSpacing="2"
                                   Margin="0,0,0,10"/>

                        <!-- 5-band EQ: Bass / Low / Mid / High / Air -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <!-- Each band: label + vertical slider -->
                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <Slider Orientation="Vertical" Height="60"
                                        Minimum="0" Maximum="100" Value="50"
                                        HorizontalAlignment="Center"/>
                                <TextBlock Text="60" Foreground="{StaticResource MutedBrush}"
                                           FontSize="9" HorizontalAlignment="Center"
                                           Margin="0,4,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                <Slider Orientation="Vertical" Height="60"
                                        Minimum="0" Maximum="100" Value="55"
                                        HorizontalAlignment="Center"/>
                                <TextBlock Text="250" Foreground="{StaticResource MutedBrush}"
                                           FontSize="9" HorizontalAlignment="Center"
                                           Margin="0,4,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <Slider Orientation="Vertical" Height="60"
                                        Minimum="0" Maximum="100" Value="50"
                                        HorizontalAlignment="Center"/>
                                <TextBlock Text="1k" Foreground="{StaticResource MutedBrush}"
                                           FontSize="9" HorizontalAlignment="Center"
                                           Margin="0,4,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                                <Slider Orientation="Vertical" Height="60"
                                        Minimum="0" Maximum="100" Value="48"
                                        HorizontalAlignment="Center"/>
                                <TextBlock Text="4k" Foreground="{StaticResource MutedBrush}"
                                           FontSize="9" HorizontalAlignment="Center"
                                           Margin="0,4,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                                <Slider Orientation="Vertical" Height="60"
                                        Minimum="0" Maximum="100" Value="52"
                                        HorizontalAlignment="Center"/>
                                <TextBlock Text="16k" Foreground="{StaticResource MutedBrush}"
                                           FontSize="9" HorizontalAlignment="Center"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

            </Grid>
        </Grid>

        <!-- ═══════════════════════════════════ FOOTER ══ -->
        <Border Grid.Row="2"
                BorderBrush="#309B5DE5"
                BorderThickness="0,1,0,0"
                Padding="20,0">
            <Grid VerticalAlignment="Center">
                <TextBlock x:Name="StatusText"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="11"
                           VerticalAlignment="Center">
                    <Run Text="MyDJ — "/>
                    <Run x:Name="StatusRun"
                         Text="Ready"
                         Foreground="{StaticResource PurpleBrightBrush}"/>
                </TextBlock>

                <Button x:Name="LoadFolderButton"
                        HorizontalAlignment="Right"
                        Content="📁  Load Folder"
                        Style="{StaticResource ControlButtonStyle}"
                        Click="LoadFolderButton_Click"
                        Foreground="{StaticResource PurpleBrightBrush}"
                        BorderBrush="#309B5DE5"
                        BorderThickness="1"
                        Padding="12,6"/>
            </Grid>
        </Border>

    </Grid>
</Window>
