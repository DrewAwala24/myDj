<Window x:Class="MyPersonalDjGui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MyDJ" Height="640" Width="980"
        Background="{StaticResource DeepBrush}"
        FontFamily="Segoe UI"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResizeWithGrip">

    <!-- ROOT: header / main / footer -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <!-- Header -->
            <RowDefinition Height="*"/>
            <!-- Main content -->
            <RowDefinition Height="42"/>
            <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0"
                BorderBrush="#309B5DE5"
                BorderThickness="0,0,0,1"
                Padding="20,0">
            <Grid>
                <TextBlock Text="⬡  MyDJ"
                           Foreground="{StaticResource PurpleBrightBrush}"
                           FontSize="20" FontWeight="Bold"
                           VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot"
                             Width="8" Height="8"
                             Fill="{StaticResource AccentBrush}"
                             Margin="0,0,6,0"/>
                    <TextBlock x:Name="HeaderStatus"
                               Text="Ready"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="12"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN -->
        <Grid Grid.Row="1" Margin="16,12,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="290"/>
            </Grid.ColumnDefinitions>

            <!-- NOW PLAYING -->
            <Border Grid.Column="0"
                    Background="{StaticResource CardBrush}"
                    BorderBrush="#309B5DE5"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="28,24">
                <StackPanel>
                    <TextBlock Text="NOW PLAYING"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="10" FontWeight="SemiBold"
                               Margin="0,0,0,18"/>
                    <Ellipse Width="110" Height="110"
                             HorizontalAlignment="Center"
                             Margin="0,0,0,20">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#1A0030" Offset="0.0"/>
                                <GradientStop Color="#2D0050" Offset="0.45"/>
                                <GradientStop Color="#9B5DE5" Offset="0.46"/>
                                <GradientStop Color="#9B5DE5" Offset="0.52"/>
                                <GradientStop Color="#1A0030" Offset="0.53"/>
                                <GradientStop Color="#1A0030" Offset="1.0"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <TextBlock x:Name="SongTitleText"
                               Text="No Song Selected"
                               Foreground="White"
                               FontSize="22" FontWeight="Bold"
                               TextTrimming="CharacterEllipsis"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,4"/>
                    <TextBlock x:Name="ArtistText"
                               Text="— / —"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="12"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,22"/>
                    <Slider x:Name="SeekBar"
                            Style="{StaticResource SeekSliderStyle}"
                            Minimum="0" Maximum="100" Value="0"
                            Margin="0,0,0,6"
                            ValueChanged="SeekBar_ValueChanged"/>
                    <Grid Margin="0,0,0,22">
                        <TextBlock x:Name="TimeElapsed"
                                   Text="0:00"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11"
                                   HorizontalAlignment="Left"/>
                        <TextBlock x:Name="TimeTotal"
                                   Text="0:00"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11"
                                   HorizontalAlignment="Right"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,22">
                        <Button x:Name="ShuffleButton"
                                Content="⇄"
                                Style="{StaticResource ControlButtonStyle}"
                                Click="ShuffleButton_Click"
                                ToolTip="Shuffle"
                                Margin="0,0,4,0"/>
                        <Button x:Name="PrevButton"
                                Content="⏮"
                                Style="{StaticResource ControlButtonStyle}"
                                Click="PrevButton_Click"
                                ToolTip="Previous"
                                Margin="0,0,4,0"/>
                        <Button x:Name="PlayButton"
                                Content="▶"
                                Style="{StaticResource PlayButtonStyle}"
                                Click="PlayButton_Click"
                                ToolTip="Play / Pause"
                                Margin="0,0,4,0"/>
                        <Button x:Name="NextButton"
                                Content="⏭"
                                Style="{StaticResource ControlButtonStyle}"
                                Click="NextButton_Click"
                                ToolTip="Next"
                                Margin="0,0,4,0"/>
                        <Button x:Name="StopButton"
                                Content="⏹"
                                Style="{StaticResource ControlButtonStyle}"
                                Click="StopButton_Click"
                                ToolTip="Stop"/>
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="38"/>
                        </Grid.ColumnDefinitions>
                        <!-- Volume controls removed -->
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Sidebar -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0"
                        Background="{StaticResource CardBrush}"
                        BorderBrush="#309B5DE5"
                        BorderThickness="1"
                        CornerRadius="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0"
                                BorderBrush="#309B5DE5"
                                BorderThickness="0,0,0,1"
                                Padding="14,10">
                            <Grid>
                                <TextBlock Text="PLAYLIST"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontSize="10" FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                                <Border HorizontalAlignment="Right"
                                        Background="#1F9B5DE5"
                                        CornerRadius="10"
                                        Padding="6,2">
                                    <TextBlock x:Name="SongCountLabel"
                                               Text="0 songs"
                                               Foreground="{StaticResource MutedBrush}"
                                               FontSize="10"/>
                                </Border>
                            </Grid>
                        </Border>
                        <ListBox x:Name="SongListBox"
                                 Grid.Row="1"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="White"
                                 FontSize="13"
                                 ItemContainerStyle="{StaticResource SongListItemStyle}"
                                 SelectionChanged="SongListBox_SelectionChanged"
                                 MouseDoubleClick="SongListBox_MouseDoubleClick"/>
                    </Grid>
                </Border>
            </Grid>

        </Grid>

        <!-- FOOTER -->
        <Border Grid.Row="2"
                BorderBrush="#309B5DE5"
                BorderThickness="0,1,0,0"
                Padding="20,0">
            <Grid VerticalAlignment="Center">
                <TextBlock x:Name="StatusText"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="11"
                           VerticalAlignment="Center">
                    <Run Text="MyDJ — "/>
                    <Run x:Name="StatusRun"
                         Text="Ready"
                         Foreground="{StaticResource PurpleBrightBrush}"/>
                </TextBlock>
                <Button x:Name="LoadFolderButton"
                        HorizontalAlignment="Right"
                        Content="📁  Load Folder"
                        Style="{StaticResource ControlButtonStyle}"
                        Click="LoadFolderButton_Click"
                        Foreground="{StaticResource PurpleBrightBrush}"
                        BorderBrush="#309B5DE5"
                        BorderThickness="1"
                        Padding="12,6"/>
            </Grid>
        </Border>
    </Grid>
</Window>
